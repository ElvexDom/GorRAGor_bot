# TMDB API
TMDB_TOKEN=your_tmdb_bearer_token_here

# Kaggle API
# Obtenir sur https://www.kaggle.com/settings/account -> API -> Create New Token
KAGGLE_API_TOKEN=KGAT_your_token_here

# Supabase (PostgreSQL) — optionnel, SQLite local en fallback si absent
# Obtenir sur https://supabase.com -> Project Settings -> Database -> URI
SUPABASE_DB_URL=postgresql://postgres:your_password@db.your_project_ref.supabase.co:5432/postgres
